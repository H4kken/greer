# Postgres connection string. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://greer:greer@localhost:5432/greer

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this Greer instance.
BETTER_AUTH_URL=http://localhost:3000

# Registration closes once the first account exists. Set to true to let more
# people sign up; each gets their own workspace. An LLM key set below is then
# used by every workspace that hasn't saved its own in Settings.
ALLOW_REGISTRATION=false

# AI does two jobs (you can also pick models in Settings → AI; saved choices
# and keys win over these):
# - sorting threads: every new thread, so a fast, cheap model. TypeSafe Jev is
#   the cheapest (about 5 cents per 1,000 threads) and is used when its key is set.
# - writing help: keyword suggestions, reading answers, reply ideas. A mid-size LLM.
# One Claude or OpenAI key can do both; Claude defaults to claude-haiku-4-5 for
# sorting and claude-sonnet-5 for writing.
# TYPESAFE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Required for OpenAI and Ollama (no defaults), optional overrides for Claude:
# LLM_SORTING_MODEL=
# LLM_WRITING_MODEL=
# LLM_PROVIDER=mock   # tests and demos: deterministic answers, no API calls
